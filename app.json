{
  "expo": {
    "name": "certmart",
    "slug": "certmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "jsEngine": "hermes",
    "plugins": [
      [
        "expo-document-picker"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you set your profile picture.",
          "cameraPermission": "The app needs access to your camera to take a profile picture.",
          "allowsEditing": true,
          "allowsMultipleSelection": false,
          "mediaTypes": "Images",
          "android": {
            "useMediaPicker": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "minifyEnabled": true,
            "shrinkResources": true,
            "proguardRules": "-keep class com.facebook.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class androidx.** { *; }\n# keep RN bridge, don't obfuscate methods used by reflection\n-keepclassmembers class * {\n  @android.webkit.JavascriptInterface <methods>;\n}"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yomzeew.certmart",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yomzeew.certmart",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "6004e9cd-7ddf-4290-854c-f4c6293d214b"
      }
    }
  }
}
